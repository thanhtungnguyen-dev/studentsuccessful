# Compose initializes PostgreSQL and builds both Python service URLs from these.
# Development credentials only; Compose is local development infrastructure.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studentsuccessful

# Native backend only: keep this URL consistent with the database you connect to.
# Compose deliberately ignores DATABASE_URL and derives it from POSTGRES_*.
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/studentsuccessful"
# Optional direct/admin PostgreSQL connection used by Alembic. Native local
# development may omit this and Alembic will fall back to DATABASE_URL.
DATABASE_MIGRATION_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/studentsuccessful"
# Production configuration uses deploy/production.env.example and platform
# secrets. Do not put managed database or object-storage credentials here.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
APP_ENV=development
HOST=0.0.0.0
PORT=8000
SESSION_COOKIE_NAME=__Host-ss_session
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_BACKEND=local
# Demo/staging-only opt-in for ephemeral platform disks. Keep false for
# durable deployments; local uploads can disappear after restart or redeploy.
ALLOW_EPHEMERAL_LOCAL_STORAGE=false
STORAGE_LOCAL_ROOT=./data/resumes
# Optional Phase 21 public ATS boards or bounded RSS/Atom feeds. Keep this as
# an empty JSON array until you configure a source; no credentials are needed.
# Supported families: greenhouse, lever, ashby, smartrecruiters, rss.
# RSS feeds require a public HTTPS feed_url and explicit allowed_job_hosts.
LIVE_JOB_SOURCES_JSON=[]
LIVE_JOB_HTTP_TIMEOUT_SECONDS=10
# Phase 19 collector: each configured board persists its own schedule and
# health state. Per-board poll_interval_seconds/request_timeout_seconds remain
# optional in LIVE_JOB_SOURCES_JSON; these are conservative global defaults.
LIVE_COLLECTOR_CONCURRENCY=3
LIVE_COLLECTOR_MAX_BACKOFF_SECONDS=3600
# Phase 25 worker lease and heartbeat defaults. They make a stopped collector
# distinguishable from a single source failure in the production deployment.
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_STALE_SECONDS=180
# Phase 20 canonical jobs: NEW is derived from first_seen_at; closure requires
# multiple clean, complete successful source absences and never fetch failure.
JOB_NEW_WINDOW_HOURS=72
JOB_CLOSE_AFTER_SUCCESSFUL_ABSENCES=2
# Native Next.js uses loopback by default. To override, export BACKEND_INTERNAL_URL
# in the frontend shell before next dev/build; root .env is not loaded by Next.js.
