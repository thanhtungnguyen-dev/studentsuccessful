# Copy these placeholder names into the deployment platform's secret store.
# Never commit a populated version of this file.

# PRIVATE: managed PostgreSQL with TLS and a least-privilege application user.
DATABASE_URL=postgresql+psycopg2://APP_USER:REPLACE_ME@DB_HOST:5432/studentsuccessful?sslmode=require
# Optional direct/admin PostgreSQL URL used only by the one-off Alembic migration job.
# When omitted, Alembic falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql+psycopg2://MIGRATION_USER:REPLACE_ME@DB_HOST:5432/studentsuccessful?sslmode=require

# PUBLIC: exact HTTPS browser origin. It must not contain a path or wildcard.
FRONTEND_ORIGIN=https://app.example.com

# PRIVATE: private S3-compatible object storage. Keep public bucket access blocked.
STORAGE_S3_BUCKET=studentsuccessful-private-resumes
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_PREFIX=resumes
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_SESSION_TOKEN=

# DEMO/STAGING ONLY: set true only with STORAGE_BACKEND=local on an ephemeral
# platform filesystem such as Render. Uploaded resumes can disappear after a
# restart or redeploy. Keep false for durable production deployments.
ALLOW_EPHEMERAL_LOCAL_STORAGE=false

# SOURCE CONFIG: a JSON array, injected from the platform configuration.
# Start with vetted public source identities; this contains no credentials.
LIVE_JOB_SOURCES_JSON=[]

# Conservative operational defaults.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
LIVE_JOB_HTTP_TIMEOUT_SECONDS=10
LIVE_COLLECTOR_CONCURRENCY=3
LIVE_COLLECTOR_MAX_BACKOFF_SECONDS=3600
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_STALE_SECONDS=180
JOB_NEW_WINDOW_HOURS=72
JOB_CLOSE_AFTER_SUCCESSFUL_ABSENCES=2
